      <column caption='duração média hora minuto' datatype='real' default-format='*hh:mm' name='[Calculation_1075661195386884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([average_duration_seconds]) / 86400' />
      </column>
      <column caption='mes' datatype='string' name='[Calculation_1075661201002501]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [period]&#13;&#10;    WHEN &quot;01&quot; THEN &quot;jan&quot;&#13;&#10;    WHEN &quot;02&quot; THEN &quot;fev&quot;&#13;&#10;    WHEN &quot;03&quot; THEN &quot;mar&quot;&#13;&#10;    WHEN &quot;04&quot; THEN &quot;abr&quot;&#13;&#10;    WHEN &quot;05&quot; THEN &quot;mai&quot;&#13;&#10;    WHEN &quot;06&quot; THEN &quot;jun&quot;&#13;&#10;    WHEN &quot;07&quot; THEN &quot;jul&quot;&#13;&#10;    WHEN &quot;08&quot; THEN &quot;ago&quot;&#13;&#10;    WHEN &quot;09&quot; THEN &quot;set&quot;&#13;&#10;    WHEN &quot;10&quot; THEN &quot;out&quot;&#13;&#10;    WHEN &quot;11&quot; THEN &quot;nov&quot;&#13;&#10;    WHEN &quot;12&quot; THEN &quot;dez&quot;&#13;&#10;END' />
      </column>
      <column caption='Duracao_media_mensal_hhmm:' datatype='real' default-format='*hh:mm' name='[Calculation_1075661201940486]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([average_duration_seconds]) / 86400' />
      </column>
