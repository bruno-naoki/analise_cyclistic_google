      <column caption='Percentual correto' datatype='real' name='[Calculation_0774670947131392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([value]) /&#13;&#10;MIN(&#13;&#10;    { FIXED [member_casual] : SUM([value]) }&#13;&#10;)' />
