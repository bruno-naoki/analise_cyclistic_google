            <column-instance column='[metric]' derivation='None' name='[none:metric:nk]' pivot='key' type='nominal' />
            <column-instance column='[period]' derivation='None' name='[none:period:nk]' pivot='key' type='nominal' />
            <column-instance column='[period_type]' derivation='None' name='[none:period_type:nk]' pivot='key' type='nominal' />
            <column caption='Period' datatype='string' name='[period]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Friday&quot;' value='Sexta' />
                <alias key='&quot;Monday&quot;' value='Segunda' />
                <alias key='&quot;Saturday&quot;' value='Sabado' />
                <alias key='&quot;Sunday&quot;' value='Domingo' />
                <alias key='&quot;Thursday&quot;' value='Quinta' />
                <alias key='&quot;Tuesday&quot;' value='Terça' />
                <alias key='&quot;Wednesday&quot;' value='Quarta' />
              </aliases>
            </column>
            <column caption='Period Type' datatype='string' name='[period_type]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1075661195386884]' derivation='User' name='[usr:Calculation_1075661195386884:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0vx8i3j1ktfobi1dg4gg311mwfn0].[none:metric:nk]'>
            <groupfilter function='member' level='[none:metric:nk]' member='&quot;average_duration&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
