      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Duração média das viagens por dia da semana — Casual vs. Member</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (cyclistic_summary_tableau)' name='federated.0vx8i3j1ktfobi1dg4gg311mwfn0' />
          </datasources>
          <datasource-dependencies datasource='federated.0vx8i3j1ktfobi1dg4gg311mwfn0'>
            <column caption='duração média hora minuto' datatype='real' default-format='*hh:mm' name='[Calculation_1075661195386884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([average_duration_seconds]) / 86400' />
            </column>
            <column caption='Average Duration Seconds' datatype='real' datatype-customized='true' name='[average_duration_seconds]' role='dimension' type='quantitative' />
            <column caption='Member Casual' datatype='string' name='[member_casual]' role='dimension' type='nominal'>
              <aliases>
